<!DOCTYPE html>
<html lang="es">
  <head>
      <meta charset="UTF-8">
      <title>Temas del Momento | SwitBy</title>
      <link rel="stylesheet" href="/css/bootstrap.min.css">
      <link rel="stylesheet" href="/main.css">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  </head>
  <body class="bg-light">
      <%- include('../../partials/header') %>
      <div class="container-fluid">
          <div class="row min-vh-100">
              <!-- Sidebar -->
              <%- include('../../partials/sideBarLeft') %>

              <!-- Contenido Principal: Temas -->
              <section class="col-12 col-md-9 p-4">
                  <div class="card border-0 shadow-sm">
                      <div class="card-header bg-white border-bottom py-3">
                          <h5 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i> Tendencias para ti</h5>
                      </div>
                      <div class="list-group list-group-flush">
                          <% temas.forEach((tema, index) => { %>
                              <a href="#" class="list-group-item list-group-item-action py-3">
                                  <div class="d-flex justify-content-between align-items-center">
                                      <div>
                                          <small class="text-muted">Tendencia <%= index + 1 %></small>
                                          <h5 class="fw-bold mb-1 mt-1 text-dark"><%= tema.nombre %></h5>
                                          <small class="text-muted"><%= tema.posts %> posts sobre esto</small>
                                      </div>
                                      <i class="bi bi-three-dots text-muted"></i>
                                  </div>
                              </a>
                          <% }) %>
                      </div>
                  </div>
              </section>
          </div>
      </div>
      <%- include('../../partials/footer') %>
  </body>
</html>