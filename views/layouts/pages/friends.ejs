<!DOCTYPE html>
<html lang="es">
  <head>
      <meta charset="UTF-8">
      <title>Amigos | SwitBy</title>
      <link rel="stylesheet" href="/css/bootstrap.min.css">
      <link rel="stylesheet" href="/main.css">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  </head>
  <body class="bg-light">

      <%- include('../../partials/header') %>

      <div class="container-fluid">
          <div class="row min-vh-100">

              <%- include('../../partials/sideBarLeft') %>          

              <!-- Contenido Principal: Amigos -->
              <section class="col-12 col-md-9 p-4">
                  
                  <div class="d-flex justify-content-between align-items-center mb-4">
                      <h4 class="fw-bold mb-0">Descubrir Personas</h4>
                      <span class="text-muted">Sugerencias para ti</span>
                  </div>

                  <div class="row g-3">
                      <% if (sugerencias && sugerencias.length > 0) { %>
                          <% sugerencias.forEach(persona => { %>
                              <div class="col-md-6 col-lg-4">
                                  <div class="card border-0 shadow-sm h-100 text-center p-3 hover-bg-light">
                                      <img src="<%= persona.avatar_url || '/images/default-user.png' %>" class="rounded-circle mx-auto mb-3 border" width="80" height="80" style="object-fit: cover;">
                                      <h5 class="fw-bold mb-1"><%= persona.username %></h5>
                                      <p class="text-muted small mb-3 text-truncate"><%= persona.bio || 'Sin biografía' %></p>
                                      
                                      <!-- Botón interactivo (Visual por ahora) -->
                                      <button class="btn btn-outline-primary btn-sm rounded-pill fw-bold w-100">
                                          <i class="bi bi-person-plus"></i> Seguir
                                      </button>
                                  </div>
                              </div>
                          <% }) %>
                      <% } else { %>
                          <div class="text-center text-muted mt-5">No hay sugerencias en este momento.</div>
                      <% } %>
                  </div>

              </section>
          </div>
      </div>
      <%- include('../../partials/footer') %>
  </body>
</html>